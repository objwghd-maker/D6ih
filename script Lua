local function GiveItemRemote(itemName, itemArg)
    local re = ReplicatedStorage:FindFirstChild("RemoteEvents")
    if re then
        local remote = re:FindFirstChild("GiveTool") or re:FindFirstChild("GiveItem") or re:FindFirstChild("BuyItem")
        if remote and remote:IsA("RemoteEvent") then
            if itemArg ~= nil then
                remote:FireServer(itemName, itemArg)
            else
                remote:FireServer(itemName)
            end
            return
        end
    end
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name == "GiveTool" or obj.Name == "GiveItem") then
            if itemArg ~= nil then
                obj:FireServer(itemName, itemArg)
            else
                obj:FireServer(itemName)
            end
            return
        end
    end
end

