local function HighlightNPC(model)
    if not model:IsA("Model") or not model:FindFirstChildOfClass("Humanoid") then return end
    if Players:GetPlayerFromCharacter(model) then return end
    if model:FindFirstChild("ScriptHighlight") then return end

    local npcName = string.lower(model.Name)
    local isUncle = string.find(npcName, "pete") or string.find(npcName, "uncle")

    if isUncle then
        CreateHighlight(model, Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255), 0.1, 0)
        CreateBillboardTag(model, "★ UNCLE PETE ★", Color3.fromRGB(255, 215, 0), Vector3.new(0, 3.5, 0), UDim2.new(0, 200, 0, 30))
    else
        CreateHighlight(model, Color3.fromRGB(255, 170, 0), Color3.fromRGB(150, 100, 0), 0.4, 0.1)
    end
end

local function ScanNPCs()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            HighlightNPC(obj)
        end
    end
end

Workspace.DescendantAdded:Connect(function(desc)
    task.wait(0.2)
    if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
        HighlightNPC(desc)
    end
end)

ScanNPCs()

local autoHealEnabled = true
local autoHealThreshold = 30

RunService.Heartbeat:Connect(function()
    if not autoHealEnabled then return end
    local stats = GetPlayerStats()
    if stats.Health < autoHealThreshold then
        local remotes = FindRemoteEvent("cure")
        if #remotes > 0 then
            FireRemote(remotes[1])
            SetStatus("Auto-heal triggered!", Color3.fromRGB(255, 100, 100))
        end
    end
end)

