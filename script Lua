local function ProtectGUI(gui)
    if gethui then
        gui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = CoreGui
    elseif CoreGui:FindFirstChild("RobloxGui") then
        gui.Parent = CoreGui
    else
        gui.Parent = PlayerGui
    end
end

local function FindRemoteEvent(pattern)
    local found = {}
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local name = obj.Name:lower()
            if not pattern or name:find(pattern:lower()) then
                table.insert(found, obj)
            end
        end
    end
    return found
end

local function FireRemote(remote, ...)
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer(...)
        return true
    end
    return false
end

local function GetPlayerStats()
    local stats = {
        Name = LocalPlayer.Name,
        Health = 100,
        MaxHealth = 100,
        Hunger = 100,
        Thirst = 100,
        Cash = 0,
        Level = 1,
        Experience = 0
    }
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            local name = stat.Name:lower()
            if name:find("cash") or name:find("money") or name:find("coin") then
                stats.Cash = stat.Value or 0
            elseif name:find("level") or name:find("lvl") then
                stats.Level = stat.Value or 1
            elseif name:find("exp") or name:find("xp") then
                stats.Experience = stat.Value or 0
            end
        end
    end
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            stats.Health = humanoid.Health
            stats.MaxHealth = humanoid.MaxHealth
        end
    end
    return stats
end

local function CreateHighlight(model, color, outlineColor, fillTrans, outlineTrans)
    if not model or not model:IsA("Model") then return end
    if model:FindFirstChild("ScriptHighlight") then
        model.ScriptHighlight:Destroy()
    end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ScriptHighlight"
    highlight.Adornee = model
    highlight.FillColor = color or Color3.fromRGB(255, 200, 50)
    highlight.OutlineColor = outlineColor or Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = fillTrans or 0.2
    highlight.OutlineTransparency = outlineTrans or 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model
    return highlight
end

local function CreateBillboardTag(model, text, color, offset, size)
    local head = model:FindFirstChild("Head") or model.PrimaryPart
    if not head then return end
    if head:FindFirstChild("ScriptTag") then
        head.ScriptTag:Destroy()
    end
    local bill = Instance.new("BillboardGui")
    bill.Name = "ScriptTag"
    bill.Size = size or UDim2.new(0, 200, 0, 30)
    bill.StudsOffset = offset or Vector3.new(0, 3.5, 0)
    bill.AlwaysOnTop = true
    bill.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "NPC"
    label.TextColor3 = color or Color3.fromRGB(255, 215, 0)
    label.TextStrokeTransparency = 0
    label.TextSize = 14
    label.Font = Enum.Font.GothamBlack
    label.Parent = bill
    return bill
end

