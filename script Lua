local function BuildItemsTab()
    ClearContent()
    local items = {
        {Name = "BloxyCola", Display = "⚡ Bloxy Cola"},
        {Name = "Cure", Display = "🩹 Medkit"},
        {Name = "Apple", Display = "🍎 Apple"},
        {Name = "Cookie", Display = "🍪 Cookie"},
        {Name = "Chips", Display = "🍟 Chips"},
    }

    for _, item in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(35, 30, 15)
        btn.BackgroundTransparency = 0.3
        btn.Text = "  " .. item.Display
        btn.TextColor3 = Color3.fromRGB(240, 225, 180)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamMedium
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ContentScroll

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if GiveItem(item.Name) then
                SetStatus("Gave " .. item.Display, Color3.fromRGB(255, 230, 0))
            else
                SetStatus("Failed to give item!", Color3.fromRGB(255, 100, 100))
            end
        end)
    end
end

local function BuildNPCsTab()
    ClearContent()
    local refreshBtn = Instance.new("TextButton")
    refreshBtn.Size = UDim2.new(1, -6, 0, 26)
    refreshBtn.BackgroundColor3 = Color3.fromRGB(50, 45, 25)
    refreshBtn.Text = "🔄 Scan NPCs"
    refreshBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    refreshBtn.TextSize = 11
    refreshBtn.Font = Enum.Font.GothamBold
    refreshBtn.Parent = ContentScroll

    local refreshCorner = Instance.new("UICorner")
    refreshCorner.CornerRadius = UDim.new(0, 5)
    refreshCorner.Parent = refreshBtn

    local function ScanNPCs()
        for _, child in pairs(ContentScroll:GetChildren()) do
            if child ~= refreshBtn and child ~= ContentLayout then
                child:Destroy()
            end
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -6, 0, 26)
                btn.BackgroundColor3 = Color3.fromRGB(35, 30, 15)
                btn.BackgroundTransparency = 0.3
                btn.Text = "  " .. obj.Name
                btn.TextColor3 = Color3.fromRGB(220, 210, 170)
                btn.TextSize = 11
                btn.Font = Enum.Font.GothamMedium
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = ContentScroll

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 5)
                corner.Parent = btn

                btn.MouseButton1Click:Connect(function()
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                    if hrp and LocalPlayer.Character then
                        LocalPlayer.Character:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, 3))
                        SetStatus("Teleported to " .. obj.Name, Color3.fromRGB(100, 255, 100))
                    end
                end)
            end
        end
    end

    refreshBtn.MouseButton1Click:Connect(ScanNPCs)
    ScanNPCs()
end

