local function GiveItemRemote(itemName)
    local re = ReplicatedStorage:FindFirstChild("RemoteEvents")
    if re then
        local remoteNames = {"GiveTool", "GiveItem", "BuyItem", "GetItem"}
        for _, rName in pairs(remoteNames) do
            local targetRemote = re:FindFirstChild(rName)
            if targetRemote and targetRemote:IsA("RemoteEvent") then
                targetRemote:FireServer(itemName)
            end
        end
    end
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name == "GiveTool" or obj.Name == "GiveItem") then
            obj:FireServer(itemName)
        end
    end
end

local function CreateItemButton(itemIds, displayName)
    local Btn = Instance.new("TextButton")
    Btn.Name = displayName .. "Btn"
    Btn.Size = UDim2.new(1, -6, 0, 28)
    Btn.BackgroundColor3 = Color3.fromRGB(18, 26, 36)
    Btn.Text = "  " .. displayName
    Btn.TextColor3 = Color3.fromRGB(200, 240, 255)
    Btn.TextSize = 11
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.Parent = ScrollFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(0, 255, 200)
    BtnStroke.Thickness = 1
    BtnStroke.Transparency = 0.7
    BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    BtnStroke.Parent = Btn

    Btn.MouseEnter:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 40, 55)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.15), {Transparency = 0.2}):Play()
    end)

    Btn.MouseLeave:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(18, 26, 36)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.15), {Transparency = 0.7}):Play()
    end)

    Btn.MouseButton1Click:Connect(function()
        SubText.Text = "Spawning..."
        SubText.TextColor3 = Color3.fromRGB(0, 255, 170)
        
        if type(itemIds) == "table" then
            for _, id in ipairs(itemIds) do
                GiveItemRemote(id)
            end
        else
            GiveItemRemote(itemIds)
        end
    end)
end

