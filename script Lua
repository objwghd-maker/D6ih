task.spawn(function()
    while true do
        if autoHealEnabled then
            GiveItem("Cookie")
            local char = LocalPlayer.Character
            if char then
                local cookie = LocalPlayer.Backpack:FindFirstChild("Cookie") or char:FindFirstChild("Cookie")
                if cookie then
                    cookie.Parent = char
                    cookie:Activate()
                end
            end
            task.wait(0.05)
        else
            task.wait(0.2)
        end
    end
end)

