local function BuildItemsTab()
    ClearContent()

    local items = {
        {Name = "BloxyCola", Display = "⚡ Bloxy Cola", Arg = nil},
        {Name = "Cure", Display = "🩹 Red Medkit", Arg = nil},
        {Name = "Apple", Display = "🍎 Apple", Arg = nil},
        {Name = "Cookie", Display = "🍪 Cookie", Arg = nil},
        {Name = "Chips", Display = "🍟 Chips", Arg = nil},
    }

    for _, item in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(35, 30, 15)
        btn.BackgroundTransparency = 0.3
        btn.Text = "  " .. item.Display
        btn.TextColor3 = Color3.fromRGB(240, 225, 180)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamMedium
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ContentScroll

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 215, 0)
        stroke.Thickness = 1
        stroke.Transparency = 0.6
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = btn

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfoOut, {BackgroundTransparency = 0.1}):Play()
            TweenService:Create(stroke, TweenInfoOut, {Transparency = 0.2}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfoOut, {BackgroundTransparency = 0.3}):Play()
            TweenService:Create(stroke, TweenInfoOut, {Transparency = 0.6}):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            SetStatus("Spawning " .. item.Display, Color3.fromRGB(255, 230, 0))
            local remotes = FindRemoteEvent("give")
            if #remotes > 0 then
                FireRemote(remotes[1], item.Name, item.Arg)
            else
                local re = ReplicatedStorage:FindFirstChild("RemoteEvents")
                if re then
                    local remote = re:FindFirstChild("GiveTool") or re:FindFirstChild("GiveItem") or re:FindFirstChild("BuyItem")
                    if remote then
                        FireRemote(remote, item.Name, item.Arg)
                    end
                end
            end
        end)
    end
end
local function BuildNPCsTab()
    ClearContent()

    local refreshBtn = Instance.new("TextButton")
    refreshBtn.Size = UDim2.new(1, -8, 0, 28)
    refreshBtn.BackgroundColor3 = Color3.fromRGB(50, 45, 25)
    refreshBtn.Text = "🔄 Refresh NPC List"
    refreshBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    refreshBtn.TextSize = 12
    refreshBtn.Font = Enum.Font.GothamBold
    refreshBtn.Parent = ContentScroll

    local refreshCorner = Instance.new("UICorner")
    refreshCorner.CornerRadius = UDim.new(0, 6)
    refreshCorner.Parent = refreshBtn

    local function ScanAndDisplayNPCs()
        for _, child in pairs(ContentScroll:GetChildren()) do
            if child ~= refreshBtn and child ~= ContentLayout then
                child:Destroy()
            end
        end

        local npcs = {}
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                table.insert(npcs, obj)
            end
        end

        if #npcs == 0 then
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -8, 0, 24)
            lbl.BackgroundTransparency = 1
            lbl.Text = "No NPCs found"
            lbl.TextColor3 = Color3.fromRGB(150, 140, 100)
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamLight
            lbl.Parent = ContentScroll
            return
        end

        for _, npc in ipairs(npcs) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(35, 30, 15)
            btn.BackgroundTransparency = 0.3
            btn.Text = "  " .. npc.Name
            btn.TextColor3 = Color3.fromRGB(220, 210, 170)
            btn.TextSize = 11
            btn.Font = Enum.Font.GothamMedium
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = ContentScroll

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = btn

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(200, 180, 100)
            stroke.Thickness = 1
            stroke.Transparency = 0.7
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = btn

            local isUncle = string.lower(npc.Name):find("pete") or string.lower(npc.Name):find("uncle")

            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfoOut, {BackgroundTransparency = 0.1}):Play()
                TweenService:Create(stroke, TweenInfoOut, {Transparency = 0.2}):Play()
                if isUncle then
                    CreateHighlight(npc, Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255), 0.1, 0)
                else
                    CreateHighlight(npc, Color3.fromRGB(255, 170, 0), Color3.fromRGB(150, 100, 0), 0.3, 0.1)
                end
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfoOut, {BackgroundTransparency = 0.3}):Play()
                TweenService:Create(stroke, TweenInfoOut, {Transparency = 0.7}):Play()
                local h = npc:FindFirstChild("ScriptHighlight")
                if h then h:Destroy() end
            end)

            btn.MouseButton1Click:Connect(function()
                local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                if hrp and LocalPlayer.Character then
                    LocalPlayer.Character:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, 3))
                    SetStatus("Teleported to " .. npc.Name, Color3.fromRGB(100, 255, 100))
                end
            end)
        end
    end

    refreshBtn.MouseButton1Click:Connect(ScanAndDisplayNPCs)
    ScanAndDisplayNPCs()

    local updateConnection
    updateConnection = RunService.Heartbeat:Connect(function()
        if not ContentScroll:IsDescendantOf(Players.LocalPlayer) then
            updateConnection:Disconnect()
            return
        end
        ScanAndDisplayNPCs()
    end)
    task.wait(10)
end

