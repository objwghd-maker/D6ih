        SetStatus(autoHealEnabled and "Auto Cookie ON" or "Auto Cookie OFF", autoHealEnabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))
    end)
end

local currentTab = "Items"
local tabBuilders = {
    Items = BuildItemsTab,
    NPCs = BuildNPCsTab,
    Player = BuildPlayerTab,
    Settings = BuildSettingsTab,
}

for name, btn in pairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        if currentTab == name then return end
        currentTab = name
        for _, b in pairs(TabButtons) do
            b.BackgroundColor3 = Color3.fromRGB(35, 30, 15)
            b.TextColor3 = Color3.fromRGB(200, 180, 120)
        end
        btn.BackgroundColor3 = Color3.fromRGB(60, 50, 20)
        btn.TextColor3 = Color3.fromRGB(255, 215, 0)
        if tabBuilders[name] then tabBuilders[name]() end
        SetStatus("Loaded " .. name, Color3.fromRGB(200, 200, 255))
    end)
end

local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

